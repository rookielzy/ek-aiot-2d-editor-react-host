HOST_PORT=8080

# Existing identity service. Replace these placeholders when its contract is provided.
IDENTITY_ORIGIN=https://identity.example.internal
IDENTITY_LOGIN_PATH=/oauth/login
IDENTITY_LOGOUT_PATH=/oauth/logout
IDENTITY_USERINFO_PATH=/oauth/userinfo

# Browser-facing paths compiled into the host application.
UMI_APP_USER_INFO_URL=/api/auth/userinfo
UMI_APP_LOGOUT_URL=/api/auth/logout
UMI_APP_LOGOUT_METHOD=POST
UMI_APP_LOGIN_URL=/api/auth/login
UMI_APP_AGENT_BASE_URL=/api/agent

POSTGRES_PASSWORD=replace-me
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
