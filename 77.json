              "type": "string",
              "default": "%7B%22userId%22%3A459527545749505%2C%22mobile%22%3A%2213800138009%22%2C%22username%22%3A%2213800138009%22%2C%22grantedAuthority%22%3A%5B%22ResetPassword%22%2C%22UpdateEquipMaintenance%22%2C%22SaveEnergyPlan%22%2C%22HydraulicBalance%22%2C%22DeleteRunStrategy%22%2C%22AlarmRecovery%22%2C%22EquipmentMaintenance%22%2C%22EquipRelateArea%22%2C%22ExportAlarmReport%22%2C%22MemberManage%22%2C%22ReuseRunStrategy%22%2C%22ProjectList%22%2C%22RemoteControl%22%2C%22AreaConfig%22%2C%22EnergySmartSwitch%22%2C%22ToggleUser%22%2C%22EnergyStation%22%2C%22EquipAlias%22%2C%22RunStrategy%22%2C%22EnableStrategyPlan%22%2C%22DeleteRole%22%2C%22MultiSupreRemoteControl%22%2C%22SaveRole%22%2C%22ExportEnergyRunRecord%22%2C%22AlarmList%22%2C%22EquipmentLedger%22%2C%22EnergyPlanMode%22%2C%22RoleManage%22%2C%22CreateNewStrategyPlan%22%2C%22DeleteMember%22%2C%22Common%22%2C%22ConfigPermissionWidget%22%2C%22EditRunStrategy%22%2C%22ViewEquipMaintenance%22%2C%22EditEquipLedger%22%2C%22EditMember%22%2C%22ViewEquipLedger%22%2C%22EnableRunStrategy%22%2C%22DeleteEquipMaintenance%22%2C%22CCTV%22%2C%22ConfigMenuPermission%22%2C%22CreateRunStrategy%22%5D%2C%22entityId%22%3A459527344422913%2C%22entityName%22%3A%22%E7%BB%8F%E9%94%80%E5%95%86%E6%B5%8B%E8%AF%95%22%2C%22type%22%3A2%2C%22projectGroupingIds%22%3A%5B%5D%2C%22commandGroupIds%22%3A%5B%5D%2C%22roles%22%3A%5B%22%E8%B6%85%E7%BA%A7%E7%AE%A1%E7%90%86%E5%91%98%22%5D%2C%22expirationTime%22%3A1796918399000%7D"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "mobile": {
                    "description": "登录手机号",
                    "example": "13800138001",
                    "type": "string"
                  },
                  "password": {
                    "description": "密码",
                    "example": "123456",
                    "type": "string"
                  }
                },
                "required": ["mobile", "password"]
              },
              "example": {
                "mobile": "13800138001",
                "password": "123456"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "当前登录请求用户token"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "refresh_token": {
                      "type": "string",
                      "description": "刷新token"
                    },
                    "expires_in": {
                      "type": "string",
                      "description": "token有效期(秒)"
                    },
                    "scope": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "refresh_token",
                    "expires_in",
                    "scope"
                  ]
                },
                "example": {
                  "access_token": "396fcc47-6a5c-403d-a151-9b548a7def5d",
                  "token_type": "bearer",
                  "refresh_token": "c5bf326c-f5bf-4840-9f1a-d75425cf2c23",
                  "expires_in": 604799,
                  "scope": "server"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
