map $http_cookie $demo_access_token {
  default "";
  "~*(?:^|;\s*)ek_aiot_demo_access_token=([^;]+)" $1;
}

map $demo_access_token $demo_authorization {
  default "Bearer $demo_access_token";
  "" "";
}

upstream agent_backend {
  zone agent_backend 64k;
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;
  server agent-server:5178 resolve;
}

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /_identity_userinfo {
    internal;
    proxy_pass ${IDENTITY_ORIGIN}${IDENTITY_USERINFO_PATH};
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header Authorization $demo_authorization;
    proxy_set_header Cookie "";
    proxy_set_header x-user-header "";
    proxy_set_header X-Authenticated-User-Id "";
  }

  location /api/agent/ {
    auth_request /_identity_userinfo;
    auth_request_set $authenticated_user_id $upstream_http_x_authenticated_user_id;

    proxy_set_header X-Authenticated-User-Id $authenticated_user_id;
    proxy_set_header Cookie "";
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 660s;
    proxy_send_timeout 660s;
    proxy_pass http://agent_backend/v1/;
  }

  location = /api/auth/userinfo {
    proxy_pass ${IDENTITY_ORIGIN}${IDENTITY_USERINFO_PATH};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header Authorization $demo_authorization;
    proxy_set_header Cookie "";
    proxy_set_header x-user-header "";
    proxy_set_header X-Authenticated-User-Id "";
  }

  location = /api/auth/login {
    proxy_pass ${IDENTITY_ORIGIN}${IDENTITY_LOGIN_PATH};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header Cookie "";
    proxy_set_header x-user-header "";
    proxy_set_header X-Authenticated-User-Id "";
  }

  location = /api/auth/logout {
    proxy_pass ${IDENTITY_ORIGIN}${IDENTITY_LOGOUT_PATH};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header Authorization $demo_authorization;
    proxy_set_header Cookie "";
    proxy_set_header x-user-header "";
    proxy_set_header X-Authenticated-User-Id "";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
